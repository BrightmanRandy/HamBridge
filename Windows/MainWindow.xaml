<Window x:Class="HamBridgeWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HamBridge" Height="540" Width="700"
        Icon="hambridge.ico"
        Background="#1E1E1E" Foreground="#DCDCDC"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Tab items -->
        <Style TargetType="TabItem">
            <Setter Property="Background"  Value="#2D2D2D"/>
            <Setter Property="Foreground"  Value="#DCDCDC"/>
            <Setter Property="Padding"     Value="14,5"/>
        </Style>

        <!-- Labels -->
        <Style TargetType="Label">
            <Setter Property="Foreground"       Value="#DCDCDC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Text boxes -->
        <Style TargetType="TextBox">
            <Setter Property="Background"   Value="#3C3C3C"/>
            <Setter Property="Foreground"   Value="#DCDCDC"/>
            <Setter Property="BorderBrush"  Value="#555555"/>
            <Setter Property="Padding"      Value="4,2"/>
            <Setter Property="Margin"       Value="0,2,0,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Combo box items (dropdown rows) -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background"         Value="#3C3C3C"/>
            <Setter Property="Foreground"         Value="#DCDCDC"/>
            <Setter Property="Padding"            Value="6,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0078D7"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected"   Value="True"/>
                        <Condition Property="IsMouseOver"  Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#0078D7"/>
                    <Setter Property="Foreground" Value="White"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <!-- Combo boxes — full template to dark-theme the popup -->
        <Style TargetType="ComboBox">
            <Setter Property="Background"             Value="#3C3C3C"/>
            <Setter Property="Foreground"             Value="#DCDCDC"/>
            <Setter Property="BorderBrush"            Value="#555555"/>
            <Setter Property="Margin"                 Value="0,2,0,4"/>
            <Setter Property="Padding"                Value="6,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
            <!-- Dropdown rows: TextBlock with ellipsis -->
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="#DCDCDC"
                                   Padding="2,0"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="1"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- arrow -->
                                                <Path Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M0,0 L4,4 L8,0 Z"
                                                      Fill="#AAAAAA"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- selected item text with ellipsis -->
                            <TextBlock x:Name="ContentSite"
                                       IsHitTestVisible="False"
                                       Text="{TemplateBinding SelectionBoxItem}"
                                       Foreground="{TemplateBinding Foreground}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Margin="8,0,24,0"/>

                            <!-- dropdown popup -->
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="#3C3C3C"
                                            BorderBrush="#555555"
                                            BorderThickness="1">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel IsItemsHost="True"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Buttons -->
        <Style TargetType="Button">
            <Setter Property="Background"  Value="#0078D7"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Setter Property="Padding"     Value="14,5"/>
            <Setter Property="Cursor"      Value="Hand"/>
        </Style>

        <!-- Checkboxes -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DCDCDC"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>

        <!-- Hint text -->
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Margin"     Value="2,0,0,8"/>
        </Style>

        <!-- Section header -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="#4FC3F7"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Margin"      Value="0,10,0,6"/>
        </Style>
        <!-- VU Meter ProgressBar style — green→yellow→red gradient fill -->
        <Style x:Key="MeterStyle" TargetType="ProgressBar">
            <Setter Property="Height"          Value="8"/>
            <Setter Property="Minimum"         Value="0"/>
            <Setter Property="Maximum"         Value="100"/>
            <Setter Property="BorderBrush"     Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background"      Value="#1A1A1A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2">
                            <Grid x:Name="PART_Track" ClipToBounds="True">
                                <!-- Full-width gradient always present; clipped by PART_Indicator width -->
                                <Rectangle x:Name="PART_Indicator"
                                           HorizontalAlignment="Left">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#22CC44" Offset="0.0"/>
                                            <GradientStop Color="#22CC44" Offset="0.55"/>
                                            <GradientStop Color="#DDCC00" Offset="0.70"/>
                                            <GradientStop Color="#FF8800" Offset="0.85"/>
                                            <GradientStop Color="#FF2222" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <!-- Peak tick — a thin white line -->
                                <Rectangle x:Name="PeakTick"
                                           Width="2" HorizontalAlignment="Left"
                                           Fill="#FFFFFF" Opacity="0.7"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <DockPanel>

        <!-- ── Status bar ──────────────────────────────────────────────────────── -->
        <StatusBar DockPanel.Dock="Bottom" Background="#252526" Foreground="#DCDCDC" Height="26">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Disconnected" Foreground="#FF6B6B"/>
            </StatusBarItem>
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"/>
            <StatusBarItem>
                <TextBlock x:Name="ModeText" Text="Mode: Normal"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ── Tabs ────────────────────────────────────────────────────────────── -->
        <TabControl Background="#1E1E1E" BorderBrush="#3F3F46">

            <!-- ══ Radio tab ════════════════════════════════════════════════════ -->
            <TabItem Header="Radio">
                <Grid Margin="20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Pi host -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Label Content="Pi Host / IP:" Width="100"/>
                        <TextBox x:Name="PiHostBox" Width="220"/>
                    </StackPanel>

                    <!-- Digital mode toggle -->
                    <CheckBox Grid.Row="1" x:Name="DigitalModeCheck"
                              Content="Digital Mode  (WSJT-X / JTDX)"
                              Margin="0,0,0,14"
                              Checked="DigitalModeCheck_Changed"
                              Unchecked="DigitalModeCheck_Changed"/>

                    <!-- Connect / Disconnect -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,20">
                        <Button x:Name="ConnectBtn"    Content="Connect"    Width="110"
                                Click="ConnectBtn_Click" Margin="0,0,10,0"/>
                        <Button x:Name="DisconnectBtn" Content="Disconnect" Width="110"
                                Click="DisconnectBtn_Click"
                                Background="#444444" IsEnabled="False"/>
                    </StackPanel>

                    <!-- Volume sliders + VU meters -->
                    <Grid Grid.Row="3" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Mic / TX volume -->
                        <Label Grid.Row="0" Grid.Column="0"
                               Content="Mic Volume (TX):"
                               VerticalAlignment="Center"/>
                        <Slider Grid.Row="0" Grid.Column="1"
                                x:Name="MicVolumeSlider"
                                Minimum="0" Maximum="100" Value="100"
                                TickFrequency="10" IsSnapToTickEnabled="False"
                                VerticalAlignment="Center"
                                Foreground="#4FC3F7"
                                ValueChanged="MicVolumeSlider_Changed"/>
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   x:Name="MicVolumeLabel"
                                   Text="100%"
                                   Foreground="#DCDCDC"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0"/>

                        <!-- Mic VU meter -->
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="TX Level:"
                                   Foreground="#888888" FontSize="10"
                                   VerticalAlignment="Center"/>
                        <ProgressBar Grid.Row="1" Grid.Column="1"
                                     x:Name="MicMeter"
                                     Style="{StaticResource MeterStyle}"
                                     Value="0"
                                     VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="2"
                                   x:Name="MicMeterLabel"
                                   Text="–∞"
                                   Foreground="#888888" FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0"/>

                        <!-- Speaker / RX volume -->
                        <Label Grid.Row="2" Grid.Column="0"
                               Content="Speaker Volume (RX):"
                               VerticalAlignment="Center"
                               Margin="0,8,0,0"/>
                        <Slider Grid.Row="2" Grid.Column="1"
                                x:Name="RxVolumeSlider"
                                Minimum="0" Maximum="100" Value="100"
                                TickFrequency="10" IsSnapToTickEnabled="False"
                                VerticalAlignment="Center"
                                Margin="0,8,0,0"
                                Foreground="#4FC3F7"
                                ValueChanged="RxVolumeSlider_Changed"/>
                        <TextBlock Grid.Row="2" Grid.Column="2"
                                   x:Name="RxVolumeLabel"
                                   Text="100%"
                                   Foreground="#DCDCDC"
                                   VerticalAlignment="Center"
                                   Margin="6,8,0,0"/>

                        <!-- RX VU meter -->
                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Text="RX Level:"
                                   Foreground="#888888" FontSize="10"
                                   VerticalAlignment="Center"/>
                        <ProgressBar Grid.Row="3" Grid.Column="1"
                                     x:Name="RxMeter"
                                     Style="{StaticResource MeterStyle}"
                                     Value="0"
                                     VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="3" Grid.Column="2"
                                   x:Name="RxMeterLabel"
                                   Text="–∞"
                                   Foreground="#888888" FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0"/>
                    </Grid>

                    <!-- Info notes -->
                    <TextBlock Grid.Row="4" Style="{StaticResource Hint}"
                               Text="Radio is keyed directly via HRD — no PTT integration."/>

                    <TextBlock Grid.Row="5" Style="{StaticResource Hint}"
                               Text="In Digital Mode, TX audio is read from CABLE Output (WSJT-X / JTDX output).&#x0a;RX audio is mirrored to CABLE Input so WSJT-X / JTDX can decode it via CABLE Output."/>
                </Grid>
            </TabItem>

            <!-- ══ Settings tab ══════════════════════════════════════════════════ -->
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,12">
                    <StackPanel>

                        <!-- Audio section -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Audio Devices" Margin="0,0,0,6"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Mic (normal TX) -->
                            <Label Grid.Row="0" Grid.Column="0"
                                   Content="Microphone  (Normal TX):"/>
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      x:Name="MicDeviceCombo"/>

                            <!-- RX output -->
                            <Label Grid.Row="1" Grid.Column="0"
                                   Content="RX Output  (Speakers):"/>
                            <ComboBox Grid.Row="1" Grid.Column="1"
                                      x:Name="RxDeviceCombo"/>

                            <!-- RX mirror -->
                            <Label Grid.Row="2" Grid.Column="0"
                                   Content="RX Mirror  (→ WSJT-X input):"/>
                            <StackPanel Grid.Row="2" Grid.Column="1">
                                <ComboBox x:Name="RxMirrorDeviceCombo"/>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Select 'CABLE Input' here. WSJT-X / JTDX audio IN → 'CABLE Output'."/>
                            </StackPanel>

                            <!-- Digital TX source -->
                            <Label Grid.Row="4" Grid.Column="0"
                                   Content="Digital TX Source  (CABLE Out):"/>
                            <StackPanel Grid.Row="4" Grid.Column="1">
                                <ComboBox x:Name="TxDigitalDeviceCombo"/>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Select 'CABLE Output' here. WSJT-X / JTDX audio OUT → 'CABLE Input'."/>
                            </StackPanel>
                        </Grid>

                        <!-- Network section -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Network Ports"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="RX Port  (Pi → Windows):"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="RxPortBox"/>

                            <Label Grid.Row="1" Grid.Column="0" Content="TX Port  (Windows → Pi):"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxPortBox"/>

                            <Label Grid.Row="2" Grid.Column="0" Content="Camera Port  (MJPEG HTTP):"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="CameraPortBox"/>
                        </Grid>

                        <!-- Save -->
                        <Button Content="Save Settings" Width="130" HorizontalAlignment="Left"
                                Margin="0,10,0,0" Click="SaveSettingsBtn_Click"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══ Camera tab ═══════════════════════════════════════════════════ -->
            <TabItem Header="Camera">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Feed — black background, image letterboxed inside -->
                    <Border Grid.Row="0" Background="#000000" Margin="0">
                        <Image x:Name="CameraImage"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <!-- Bottom toolbar -->
                    <Grid Grid.Row="1" Background="#252526" Height="38">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" x:Name="CameraConnectBtn"
                                Content="Connect Camera" Width="130"
                                Margin="8,0,6,0" VerticalAlignment="Center"
                                Click="CameraConnectBtn_Click"/>
                        <Button Grid.Column="1" x:Name="CameraDisconnectBtn"
                                Content="Disconnect" Width="100"
                                Margin="0,0,12,0" VerticalAlignment="Center"
                                Background="#444444" IsEnabled="False"
                                Click="CameraDisconnectBtn_Click"/>

                        <TextBlock Grid.Column="2"
                                   x:Name="CameraStatusText"
                                   Text="Not connected"
                                   Foreground="#888888"
                                   VerticalAlignment="Center"/>

                        <!-- FPS readout -->
                        <TextBlock Grid.Column="3"
                                   x:Name="CameraFpsText"
                                   Text=""
                                   Foreground="#888888" FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>

                        <!-- Snapshot button -->
                        <Button Grid.Column="4" x:Name="SnapshotBtn"
                                Content="📷 Snapshot" Width="110"
                                Margin="0,0,8,0" VerticalAlignment="Center"
                                Background="#444444"
                                Click="SnapshotBtn_Click"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ══ Log tab ═══════════════════════════════════════════════════════ -->
            <TabItem Header="Log">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox x:Name="LogBox" Grid.Row="0"
                             Background="#141414" Foreground="#AFFFAF"
                             FontFamily="Consolas" FontSize="11"
                             IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             BorderBrush="#3F3F46"/>

                    <Button Grid.Row="1" Content="Clear Log" Width="90"
                            HorizontalAlignment="Right" Margin="0,6,0,0"
                            Click="ClearLogBtn_Click"
                            Background="#444444"/>
                </Grid>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
