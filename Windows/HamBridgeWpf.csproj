<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>HamBridge</AssemblyName>
    <RootNamespace>HamBridgeWpf</RootNamespace>
    <ApplicationIcon>hambridge.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Icon embedded as resource so it's available at runtime for the Window -->
    <Resource Include="hambridge.ico" />
  </ItemGroup>

</Project>
